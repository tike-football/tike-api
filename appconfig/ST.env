# STAGING ENV TEMPLATE (ECS)
# Standard: keep this file as non-secret template + explicit secret mapping.
# Convention:
# - Plain value: write actual value.
# - Secret value: use placeholder __FROM_SECRET_MANAGER__.
#
# -------------------------------------------------------------------
# SECRETS MAP (AWS Secrets Manager)
# -------------------------------------------------------------------
# APP_KEY               -> tike-staging/app-key : APP_KEY
# DB_HOST               -> tike-staging/rds     : host
# DB_PORT               -> tike-staging/rds     : port
# DB_DATABASE           -> tike-staging/rds     : dbname
# DB_USERNAME           -> tike-staging/rds     : username
# DB_PASSWORD           -> tike-staging/rds     : password
# MAIL_PASSWORD         -> tike-staging/mail    : MAIL_PASSWORD
# AWS_ACCESS_KEY_ID     -> tike-staging/aws     : AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY -> tike-staging/aws     : AWS_SECRET_ACCESS_KEY

# -------------------------------------------------------------------
# APP
# -------------------------------------------------------------------
APP_NAME="Tike API Staging"
APP_ENV=staging
APP_KEY=__FROM_SECRET_MANAGER__
APP_DEBUG=false
APP_URL=https://api-staging.bigmelo.com

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# -------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=__FROM_SECRET_MANAGER__
DB_PORT=__FROM_SECRET_MANAGER__
DB_DATABASE=__FROM_SECRET_MANAGER__
DB_USERNAME=__FROM_SECRET_MANAGER__
DB_PASSWORD=__FROM_SECRET_MANAGER__

# -------------------------------------------------------------------
# QUEUES / CACHE / SESSION
# -------------------------------------------------------------------
BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# -------------------------------------------------------------------
# REDIS
# -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# -------------------------------------------------------------------
# MAIL
# -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=__FROM_SECRET_MANAGER__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bigmelo.com"
MAIL_FROM_NAME="Tike API Staging"

# -------------------------------------------------------------------
# AWS
# -------------------------------------------------------------------
AWS_ACCESS_KEY_ID=__FROM_SECRET_MANAGER__
AWS_SECRET_ACCESS_KEY=__FROM_SECRET_MANAGER__
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tike-staging-assets-139194331469
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------------------
# FRONTEND LINKS
# -------------------------------------------------------------------
EMAIL_VERIFICATION_URL="https://staging.bigmelo.com/verify-email/"
RESET_PASSWORD_URL="https://staging.bigmelo.com/reset-password/"
