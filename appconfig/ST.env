# Staging environment template for ECS (non-secret values + secret placeholders)
# Copy/edit this file when you need to update staging env.
# Secrets marked as __REPLACE_IN_AWS_SECRETS_MANAGER__ must be set in AWS Secrets Manager.

APP_NAME="Tike API Staging"
APP_ENV=staging
APP_KEY=__REPLACE_IN_AWS_SECRETS_MANAGER__
APP_DEBUG=false
APP_URL=https://api-staging.bigmelo.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=__REPLACE_IN_AWS_SECRETS_MANAGER__
DB_PORT=__REPLACE_IN_AWS_SECRETS_MANAGER__
DB_DATABASE=__REPLACE_IN_AWS_SECRETS_MANAGER__
DB_USERNAME=__REPLACE_IN_AWS_SECRETS_MANAGER__
DB_PASSWORD=__REPLACE_IN_AWS_SECRETS_MANAGER__

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=__REPLACE_IN_AWS_SECRETS_MANAGER__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bigmelo.com"
MAIL_FROM_NAME="Tike API Staging"

AWS_ACCESS_KEY_ID=__REPLACE_IN_AWS_SECRETS_MANAGER__
AWS_SECRET_ACCESS_KEY=__REPLACE_IN_AWS_SECRETS_MANAGER__
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tike-staging-assets-139194331469
AWS_USE_PATH_STYLE_ENDPOINT=false

EMAIL_VERIFICATION_URL="https://staging.bigmelo.com/verify-email/"
RESET_PASSWORD_URL="https://staging.bigmelo.com/reset-password/"

# Secrets Manager references currently used by ECS task:
# APP_KEY -> arn:aws:secretsmanager:us-east-1:139194331469:secret:tike-staging/app-key:APP_KEY::
# DB_*    -> arn:aws:secretsmanager:us-east-1:139194331469:secret:tike-staging/rds:*
# MAIL_PASSWORD -> arn:aws:secretsmanager:us-east-1:139194331469:secret:tike-staging/mail-BziFNZ:MAIL_PASSWORD::
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY -> arn:aws:secretsmanager:us-east-1:139194331469:secret:tike-staging/aws:*
