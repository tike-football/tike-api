APP_NAME="Tike API Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://api-staging.bigmelo.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=tike-staging-db.cw16uk8243fq.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=tike_staging
DB_USERNAME=tikeadmin
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
# Set via AWS Secrets Manager on ECS as env var secret (do not commit).
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bigmelo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=tike-staging-assets-139194331469
AWS_USE_PATH_STYLE_ENDPOINT=false

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Links usados en emails (verificacion y reset de password)
EMAIL_VERIFICATION_URL="https://staging.bigmelo.com/verify-email/"
RESET_PASSWORD_URL="https://staging.bigmelo.com/reset-password/"

AWS_S3_URL=arn:aws:s3:::tike-staging-assets-139194331469
AWS_S3_USERS_AVATARS_FOLDER=/users/avatars/
